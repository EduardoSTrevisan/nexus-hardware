# Copie para .env e ajuste. Não envie .env ao GitHub.
SITE_URL=http://localhost:8000
# A loja começa como um projeto acadêmico fictício; não indexar.
PUBLIC_INDEXING=0
# Somente use 1 quando houver produtos reais, pagamento/termos e estoque real.
STORE_REAL=0
# Vazio = persistência JSON local, funcionando com PHP puro.
DB_DSN=
DB_USER=
DB_PASSWORD=
# Exemplo PostgreSQL: DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=nexus_hardware
# Exemplo MySQL: DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=nexus_hardware;charset=utf8mb4
# Gere segredo forte para o endpoint administrativo; sem ele o reset fica desativado.
ADMIN_TOKEN=
# Preencha apenas se o frontend estiver em outro domínio, como GitHub Pages.
# Exemplo: ALLOWED_ORIGINS=https://usuario.github.io
ALLOWED_ORIGINS=
